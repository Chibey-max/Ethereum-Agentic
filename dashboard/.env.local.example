# ═══════════════════════════════════════════════════════════════
# Arbitrum Agent Kit — Dashboard Environment
# Copy to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── ACTIVE CHAIN ────────────────────────────────────────────────
# 421614 = Arbitrum Sepolia  (judges/demos — default)
# 46630  = Robinhood Chain   (prize track)
# 42161  = Arbitrum One      (mainnet — real ETH required)
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_NETWORK_NAME=Arbitrum Sepolia

# ── CONTRACT ADDRESS FOR ACTIVE CHAIN ────────────────────────────
# Fill this after deploying AgentWallet.sol
NEXT_PUBLIC_CONTRACT_ADDRESS=0x

# ── ROBINHOOD CHAIN CONTRACT (prize track) ────────────────────────
NEXT_PUBLIC_RH_CONTRACT_ADDRESS=0x

# ── RPC URL FOR ACTIVE CHAIN ─────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── EXPLORER (auto-set by CHAIN_ID — override only if needed) ─────
# Arbitrum Sepolia: https://sepolia.arbiscan.io
# Robinhood Chain:  https://explorer.testnet.chain.robinhood.com
# Arbitrum One:     https://arbiscan.io
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.arbiscan.io

# ── WALLET CONFIG ─────────────────────────────────────────────────
NEXT_PUBLIC_GUARDIAN_ADDRESS=0x
NEXT_PUBLIC_TRUSTED_RECIPIENT=0x
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── RUNTIME ───────────────────────────────────────────────────────
RUNTIME_PATH=../runtime

# ════════════════════════════════════════════════════════════════
