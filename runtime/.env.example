# ═══════════════════════════════════════════════════════
# ETH Agent Kit — Runtime Environment
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── ACTIVE CHAIN ──────────────────────────────────────
# Switch CHAIN_ID to change which chain the agent uses.
# The corresponding RPC_URL and AGENT_CONTRACT_ADDRESS
# vars below will be picked up automatically.
#
# 421614  = Arbitrum Sepolia  (testnet — recommended for demos)
# 46630   = Robinhood Chain   (testnet — prize track)
# 42161   = Arbitrum One      (mainnet — real ETH required)
# 11155111 = Ethereum Sepolia (original)

CHAIN_ID=421614

# ── CONTRACT ADDRESSES (fill after deploy) ────────────
AGENT_CONTRACT_ADDRESS=0x            # Arbitrum Sepolia address
ARBITRUM_SEP_CONTRACT_ADDRESS=0x     # same as above
ROBINHOOD_CONTRACT_ADDRESS=0x        # Robinhood Chain address
ARBITRUM_ONE_CONTRACT_ADDRESS=0x     # Mainnet (leave blank if not deployed)
SEPOLIA_CONTRACT_ADDRESS=0xE49A6044D47De19504B73aA36F31899843B05259

# ── RPC URLS ──────────────────────────────────────────
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia

# ── AGENT WALLET ──────────────────────────────────────
# The AGENT role private key (not the guardian key)
# This address must match the agent role in AgentWallet.sol
AGENT_PRIVATE_KEY=0x
GUARDIAN_ADDRESS=0x

# ── AI PROVIDER ───────────────────────────────────────
# Free at console.groq.com — recommended
GROQ_API_KEY=
# Fallback providers (optional)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# ── OPTIONAL ──────────────────────────────────────────
T3N_API_KEY=
